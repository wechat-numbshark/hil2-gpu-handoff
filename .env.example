# ======================================================================
# HIL2.0 协调服务配置样例
#
# 复制为 .env 后填写。绝不要把真实密钥提交进代码仓库。
#   cp .env.example .env && chmod 600 .env
# ======================================================================

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8848
LOG_LEVEL=INFO
DB_PATH=var/hil2.db

# 集群脚本直连上报用的共享密钥。留空表示不校验（仅限本机回环部署）。
# 生成：openssl rand -hex 32
INGEST_TOKEN=

# ---------- 纳管范围 ----------
# 仅用于首次启动时引导集群注册表。之后集群的增删改、采集方式、阈值
# 全部在管理后台 /admin 里维护，改完立即生效，不用重启。
MANAGED_CLUSTERS=52,58,60

# ---------- 判定阈值 ----------
# 需与集群侧 HIL_IDLE_MINUTES 保持一致
IDLE_MINUTES=15
REMIND_AFTER_MINUTES=10
ESCALATE_AFTER_MINUTES=20
# 采集数据超过该时长在大盘标注「可能过期」；过期只影响展示，不会判定为可用
STALE_AFTER_MINUTES=20

# ---------- 飞书应用 ----------
# 企业自建应用，同时加入独立监控群和业务大群
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis

# 推荐 long_connection：只需出站访问飞书，不要公网 IP/域名/回调地址。
# 已有公网反代时可改 http_callback；纯离线演示可设 off。
FEISHU_EVENT_MODE=long_connection
FEISHU_CHANNEL_CONNECT_TIMEOUT_SECONDS=20
# 首次接真实租户也可先用 audit 观察；生产确认后用 strict。
FEISHU_CHANNEL_SECURITY_MODE=strict
# 方法一（GPU 网与内网隔离）：内网服务通过开放 API 轮询监控群，读取
# Agent 经自定义 Webhook 发来的 EVENT_JSON。0 表示关闭。
FEISHU_MONITOR_POLL_SECONDS=20

# HTTP 回调模式的安全设置；长连接模式可留空
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ---------- 群与人 ----------
# 独立监控群：只接 webhook 审计副本，不打扰业务大群
FEISHU_MONITOR_CHAT_ID=
# 业务大群：只出现必须的人机交互
FEISHU_BUSINESS_CHAT_ID=
# 业务机器人自身 open_id，用于 loop guard（防止消费自己发出的消息）
FEISHU_BOT_OPEN_ID=
# 管理员 open_id，逗号分隔
FEISHU_ADMIN_OPEN_IDS=

# ---------- 预约数据源 ----------
# booking：内置网页/飞书预约；file：临时队列 JSON；http：正式预约 API
# 换数据源不需要改判定引擎
RESERVATION_SOURCE=booking
RESERVATION_FILE=var/reservations.json
RESERVATION_API_URL=
RESERVATION_API_TOKEN=

# 每天开放预约 09:00–24:00（按 TIMEZONE，结束点允许次日 00:00）
BOOKING_DAY_START_HOUR=9
BOOKING_DAY_END_HOUR=24

# ---------- 大盘与免登 ----------
DASHBOARD_REFRESH_SECONDS=60
# 开启后「预约」和「管理后台」需要飞书登录。
# 大盘本身仍然免登可看——它要挂在墙上给所有人扫一眼。
SSO_ENABLED=false
# 确实需要连「看」都管起来时再打开（例如服务暴露在了不可信网络里）
REQUIRE_LOGIN_TO_VIEW=false
# 生成：openssl rand -hex 32
JWT_SECRET=
JWT_TTL_HOURS=12
# 浏览器 OAuth 回调地址，必须与飞书后台配置完全一致
SSO_REDIRECT_URI=
