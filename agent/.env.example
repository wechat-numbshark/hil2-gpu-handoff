# ======================================================================
# HIL2.0 集群侧采集脚本配置样例（放在每台集群上）
#
# 脚本对被监控环境严格只读：
#   docker ps -a / docker exec <tester> pgrep -af pytest /
#   find /data1 -mmin / nvidia-smi
# 绝不停容器、绝不杀进程、绝不删文件、绝不释放集群。
# ======================================================================

# 集群编号。一个编号 = 一个完整集群，不是一张 GPU 卡。
HIL_MACHINE_NAME=52

# 数据产出目录（现场确认后再改）
HIL_DATA_DIR=/data1

# ---------- 投递通道（两条都配最稳；任意一条可用即可工作）----------
# 主通道：直连协调服务
HIL_COORDINATOR_URL=http://10.0.0.5:8848/api/ingest
HIL_INGEST_TOKEN=

# 审计副本：独立监控群的 webhook 机器人
FEISHU_WEBHOOK=
# 业务机器人 open_id。不配的话监控群消息不会 @ 它，bot-to-bot 可能静默不投递。
HIL_CONSUMER_BOT_OPEN_ID=

# ---------- 采集节奏 ----------
HIL_SAMPLE_SECONDS=300      # 每 5 分钟一轮
HIL_IDLE_MINUTES=15         # 无活动判定窗口
HIL_CONFIRM_SAMPLES=3       # 连续 3 轮 ≈ 15 分钟才请人工确认
HIL_HEARTBEAT_SAMPLES=12    # 每 12 轮（1 小时）发一次心跳
HIL_COMMAND_TIMEOUT=30
HIL_DELIVERY_RETRIES=3

# ---------- 容器识别 ----------
# 用 probe_site.py 探测现场后，把正则换成精确容器名，例如：
#   HIL_SIM_PATTERN='^(hil-sim-1|hil-sim-2)$'
HIL_SIM_PATTERN=(^|[-_])sim(ulator)?($|[-_])
HIL_PROXY_PATTERN=(^|[-_])proxy($|[-_])
HIL_TESTER_PATTERN=tester|autotest|simlib|logsim

# 现场确认 pytest 之外还有哪些真实测试进程后再填，逗号分隔
HIL_EXTRA_TEST_PROCESSES=

# ---------- 文件路径 ----------
HIL_CLAIM_FILE=/run/hil-monitor/claim.json      # 用户维护的保留声明，脚本只读
HIL_STATE_FILE=/var/lib/hil-monitor/state.json  # 疑似空闲连击计数，重启不清零
HIL_LOG_FILE=/var/log/hil-monitor/events.jsonl  # 本地事件流水

# 灰度阶段：只写本地日志，不发任何消息
# HIL_DRY_RUN=1
